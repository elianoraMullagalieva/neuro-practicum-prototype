# Короткие адреса без .html: /cold вместо /cold.html
RewriteEngine On

# Если запрошенного файла нет, но есть такой же с .html — отдаём его
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Кэш для статики — картинки и видео не меняются
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4  "access plus 30 days"
  ExpiresByType text/css   "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
</IfModule>

# Сжатие текстовых файлов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
